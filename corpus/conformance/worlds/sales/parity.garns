# The static twin of the frozen dynamic question: identical algebra, one-shot.
# A query and a question over the same input must return byte-equivalent rows.

module sales_static "static twins of the dynamic conformance question" {
  import sales (Order)

  query open_orders_once of Order "one-shot open orders" {
    where status = @open
    show identity, customer.name as customer, total
    order created_at descending
    first 20
  }

  query revenue_open_by_customer of Order "richer static report over the same orders" {
    given floor : Money
    where status = @open and total >= floor
    show customer.name as customer, sum(total) as revenue, count() as orders, call money.round(sum(total) / count(), 2) as average_order
    group by customer.name
    having sum(total) > floor
    order sum(total) descending, call text.length(customer.name) ascending
  }

  query distinct_open_customers of Order "distinct customers with open orders" {
    where status = @open
    show customer.name as customer
    distinct
    order customer.name
  }
}
