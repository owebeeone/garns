module alpha "first module: every local name here recurs in beta" {
  intent code : Text "an alpha code"
  intent amount : Integer "an alpha amount"
  resource Root "alpha root" { use code { key } }
  trait Held "held by an alpha root" { link holder -> Root { end restrict scopes } }
  resource Item "an alpha item" {
    use code { key }
    use amount { filter }
    carry Held
  }
  question heavy of Item "alpha items above a threshold" {
    given floor : Integer
    where amount > floor
    show code, amount
    order amount descending
    live bounded 100
  }
}
